{
  "uid": "kube-resilience-lab",
  "title": "Kube Resilience Lab - measured resilience",
  "description": "Actual controller observations and intentional fault state.",
  "tags": [
    "kubernetes",
    "resilience",
    "slo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "Evidence, not an SLA certificate",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Real HTTP observations from the controller. Good = HTTP success and latency <=300ms. The 99% objective uses the last 180 samples; the error budget resets as samples leave that window. Faults are intentional and bounded. Metrics and reports are ephemeral. Grafana and Prometheus cannot prove a Kubernetes restart; CI records the pod restart count separately."
      }
    },
    {
      "id": 1,
      "title": "Good requests - rolling window",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_window_good_ratio * 100",
          "legendFormat": "Good requests - rolling window"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency - rolling window",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_window_p95_seconds * 1000",
          "legendFormat": "p95 latency - rolling window"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error budget remaining - rolling window",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_error_budget_remaining_ratio * 100",
          "legendFormat": "Error budget remaining - rolling window"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests in rolling window",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "h": 5,
